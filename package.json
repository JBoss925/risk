{
  "name": "risk-quant-terminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-dependency browser quantitative research, indicator strategy builder, WebAssembly backtester, forecaster, and paper trading terminal.",
  "scripts": {
    "build": "npm run build:wasm",
    "build:wasm": "asc wasm/engine.ts --config asconfig.json",
    "dev": "node server.mjs",
    "start": "npm run build:wasm && node server.mjs",
    "benchmark": "node scripts/run-benchmarks.mjs",
    "test": "npm run build:wasm && node --test tests/engine.test.mjs"
  },
  "devDependencies": {
    "assemblyscript": "^0.27.31"
  }
}
